{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A50 Control",
  "version": "0.1.0",
  "identifier": "com.gakkle.a50control",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "A50 Control",
        "width": 780,
        "height": 760,
        "minWidth": 420,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5MTY1RUZFQTVGRDEzMzkKUldRNUUvMmwvbDRXZVNuU3ZmeDRPWGY3dEtBbysxOU9ubjhtTU5INDlqTTRocW1hOXhpTTRhMGoK",
      "endpoints": ["https://github.com/Shane-Gadsby/Astro-A50-Control/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Utility",
    "shortDescription": "Astro A50 settings, battery and audio switching",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
